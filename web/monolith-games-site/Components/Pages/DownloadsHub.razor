@page "/downloads"

<PageTitle>Monolith Download Center / Official Software & Game Repository</PageTitle>

<div class="bg-black text-white min-h-screen p-6 md:p-10 font-sans selection:bg-amber-400 selection:text-black">

    <header class="mb-10 pb-6 border-b border-neutral-900 flex flex-wrap justify-between items-center gap-4">
        <div>
            <div class="text-xs font-mono uppercase tracking-wider text-amber-400 mb-1">📦 OFFICIAL REPOSITORY // ALL DOWNLOADS</div>
            <h1 class="text-3xl font-extrabold tracking-tight text-white mb-2">Monolith Universal Download Center</h1>
            <p class="text-neutral-400">Instant direct access to all published Android APKs, desktop applications, 3D SDKs, and multimedia assets.</p>
        </div>
        <a href="/" class="bg-neutral-900 hover:bg-neutral-800 border border-neutral-800 text-white px-4 py-2 rounded-xl text-xs font-mono transition">
            &larr; Back to Main Console
        </a>
    </header>

    <!-- Section 1: Flagship Mobile Games -->
    <section class="mb-12">
        <h2 class="text-xl font-bold text-white mb-4 flex items-center space-x-2">
            <span>🎮</span>
            <span>Flagship Mobile Games (25.6 MB HD APKs)</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-5">
            <a href="/download/voidstrikers" class="bg-neutral-950 hover:bg-neutral-900 border border-neutral-900 hover:border-amber-500/60 p-5 rounded-xl flex flex-col justify-between transition duration-300 group shadow-xl">
                <div>
                    <div class="font-bold text-base text-white group-hover:text-amber-300 transition mb-1">VoidStrikers 3D</div>
                    <div class="text-xs text-neutral-400 font-mono mb-3">25.6 MB • 60fps Space Shooter</div>
                </div>
                <div class="text-xs text-amber-400 font-mono font-bold flex items-center justify-between pt-3 border-t border-neutral-900">
                    <span>Download APK</span>
                    <span class="group-hover:translate-x-1 transition">&rarr;</span>
                </div>
            </a>
            <a href="/download/islandmonolith" class="bg-neutral-950 hover:bg-neutral-900 border border-neutral-900 hover:border-emerald-500/60 p-5 rounded-xl flex flex-col justify-between transition duration-300 group shadow-xl">
                <div>
                    <div class="font-bold text-base text-white group-hover:text-emerald-300 transition mb-1">IslandMonolith 3D</div>
                    <div class="text-xs text-neutral-400 font-mono mb-3">25.6 MB • Tropical Survival</div>
                </div>
                <div class="text-xs text-emerald-400 font-mono font-bold flex items-center justify-between pt-3 border-t border-neutral-900">
                    <span>Download APK</span>
                    <span class="group-hover:translate-x-1 transition">&rarr;</span>
                </div>
            </a>
            <a href="/download/calculator" class="bg-neutral-950 hover:bg-neutral-900 border border-neutral-900 hover:border-sky-500/60 p-5 rounded-xl flex flex-col justify-between transition duration-300 group shadow-xl">
                <div>
                    <div class="font-bold text-base text-white group-hover:text-sky-300 transition mb-1">Monolith Calculator</div>
                    <div class="text-xs text-neutral-400 font-mono mb-3">25.6 MB • Product 001 Utility</div>
                </div>
                <div class="text-xs text-sky-400 font-mono font-bold flex items-center justify-between pt-3 border-t border-neutral-900">
                    <span>Download APK</span>
                    <span class="group-hover:translate-x-1 transition">&rarr;</span>
                </div>
            </a>
            <a href="/download/aetheria" class="bg-neutral-950 hover:bg-neutral-900 border border-neutral-900 hover:border-indigo-500/60 p-5 rounded-xl flex flex-col justify-between transition duration-300 group shadow-xl">
                <div>
                    <div class="font-bold text-base text-white group-hover:text-indigo-300 transition mb-1">Aetheria Void Protocol</div>
                    <div class="text-xs text-neutral-400 font-mono mb-3">25.6 MB • Sci-Fi RPG</div>
                </div>
                <div class="text-xs text-indigo-400 font-mono font-bold flex items-center justify-between pt-3 border-t border-neutral-900">
                    <span>Download APK</span>
                    <span class="group-hover:translate-x-1 transition">&rarr;</span>
                </div>
            </a>
        </div>
    </section>

    <!-- Section 2: Enterprise Software & Tools -->
    <section class="mb-12">
        <h2 class="text-xl font-bold text-white mb-4 flex items-center space-x-2">
            <span>🛠️</span>
            <span>Enterprise Software & Developer Tools</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-5">
            <a href="/download/monolithfinancial" class="bg-neutral-950 hover:bg-neutral-900 border border-neutral-900 hover:border-amber-500/60 p-5 rounded-xl flex flex-col justify-between transition duration-300 group shadow-xl">
                <div>
                    <div class="font-bold text-base text-white group-hover:text-amber-300 transition mb-1">Monolith Financial .EXE</div>
                    <div class="text-xs text-neutral-400 font-mono mb-3">Win32 Desktop • 8K SSAA</div>
                </div>
                <div class="text-xs text-amber-400 font-mono font-bold flex items-center justify-between pt-3 border-t border-neutral-900">
                    <span>Download .EXE</span>
                    <span class="group-hover:translate-x-1 transition">&rarr;</span>
                </div>
            </a>
            <a href="/download/monolithpublish" class="bg-neutral-950 hover:bg-neutral-900 border border-neutral-900 hover:border-sky-500/60 p-5 rounded-xl flex flex-col justify-between transition duration-300 group shadow-xl">
                <div>
                    <div class="font-bold text-base text-white group-hover:text-sky-300 transition mb-1">Monolith.Publish CLI</div>
                    <div class="text-xs text-neutral-400 font-mono mb-3">Google Play Publisher API v3</div>
                </div>
                <div class="text-xs text-sky-400 font-mono font-bold flex items-center justify-between pt-3 border-t border-neutral-900">
                    <span>Download Tool</span>
                    <span class="group-hover:translate-x-1 transition">&rarr;</span>
                </div>
            </a>
            <a href="/download/engine3d" class="bg-neutral-950 hover:bg-neutral-900 border border-neutral-900 hover:border-indigo-500/60 p-5 rounded-xl flex flex-col justify-between transition duration-300 group shadow-xl">
                <div>
                    <div class="font-bold text-base text-white group-hover:text-indigo-300 transition mb-1">Monolith 3D SDK</div>
                    <div class="text-xs text-neutral-400 font-mono mb-3">Android AAR • Vector3 & PBR</div>
                </div>
                <div class="text-xs text-indigo-400 font-mono font-bold flex items-center justify-between pt-3 border-t border-neutral-900">
                    <span>Download SDK</span>
                    <span class="group-hover:translate-x-1 transition">&rarr;</span>
                </div>
            </a>
            <a href="/download/storehub" class="bg-neutral-950 hover:bg-neutral-900 border border-neutral-900 hover:border-emerald-500/60 p-5 rounded-xl flex flex-col justify-between transition duration-300 group shadow-xl">
                <div>
                    <div class="font-bold text-base text-white group-hover:text-emerald-300 transition mb-1">Monolith Store Server</div>
                    <div class="text-xs text-neutral-400 font-mono mb-3">ASP.NET Core Digital Hub</div>
                </div>
                <div class="text-xs text-emerald-400 font-mono font-bold flex items-center justify-between pt-3 border-t border-neutral-900">
                    <span>Download Server</span>
                    <span class="group-hover:translate-x-1 transition">&rarr;</span>
                </div>
            </a>
        </div>
    </section>

    <!-- Section 3: High-Density Multimedia Assets -->
    <section class="mb-8">
        <h2 class="text-xl font-bold text-white mb-4 flex items-center space-x-2">
            <span>🎵</span>
            <span>Multimedia & PBR Texture Assets</span>
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <a href="/download/ambientaudio" class="bg-neutral-950 hover:bg-neutral-900 border border-neutral-900 hover:border-amber-500/60 p-5 rounded-xl flex justify-between items-center transition duration-300 group shadow-xl">
                <div>
                    <div class="font-bold text-base text-white group-hover:text-amber-300 transition mb-1">Monolith Ambient Soundtrack (48kHz WAV)</div>
                    <div class="text-xs text-neutral-400 font-mono">5.2 MB • Cinematic Orchestral Synth Stem</div>
                </div>
                <span class="text-xs text-amber-400 font-mono font-bold group-hover:translate-x-1 transition">Download Audio &rarr;</span>
            </a>
            <a href="/download/pbrtexture" class="bg-neutral-950 hover:bg-neutral-900 border border-neutral-900 hover:border-sky-500/60 p-5 rounded-xl flex justify-between items-center transition duration-300 group shadow-xl">
                <div>
                    <div class="font-bold text-base text-white group-hover:text-sky-300 transition mb-1">Monolith 4K PBR Texture Atlas (PNG)</div>
                    <div class="text-xs text-neutral-400 font-mono">10.5 MB • High-Density Material Maps</div>
                </div>
                <span class="text-xs text-sky-400 font-mono font-bold group-hover:translate-x-1 transition">Download Atlas &rarr;</span>
            </a>
        </div>
    </section>

</div>
