@page "/icom"

<PageTitle>I.com / Global Identity & Intelligence Network</PageTitle>

<div class="min-h-screen bg-[#09090b] text-white p-8">
    <header class="flex justify-between items-center mb-16 max-w-7xl mx-auto border-b border-neutral-800 pb-6">
        <div class="text-3xl font-black tracking-widest font-mono text-sky-400">I<span class="text-white">.COM</span></div>
        <div class="flex space-x-6 text-sm font-mono text-neutral-400">
            <span class="text-sky-400">● I.COM NETWORK: ACTIVE (PORT 65001)</span>
            <span>GLOBAL IDENTITY</span>
            <span>ZERO-TRUST INTEL</span>
        </div>
    </header>

    <main class="max-w-7xl mx-auto">
        <div class="mb-16">
            <h1 class="text-5xl font-extrabold tracking-tight mb-4">The Unified Global Identity & Intelligence Fabric.</h1>
            <p class="text-xl text-neutral-400 max-w-2xl">I.com connects decentralized cryptographic identity, real-time enterprise telemetry, and autonomous AI agents across the Monolith ecosystem.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
            <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6">
                <div class="text-xs font-mono uppercase tracking-wider text-sky-400 mb-2">01 // IDENTITY MESH</div>
                <h3 class="text-xl font-bold mb-3">Decrypted Credentials</h3>
                <p class="text-neutral-400 text-sm">Enterprise credential management backed by hardware security modules and zero-trust HMAC signing.</p>
            </div>
            <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6">
                <div class="text-xs font-mono uppercase tracking-wider text-sky-400 mb-2">02 // INTELLIGENCE FEED</div>
                <h3 class="text-xl font-bold mb-3">Neural Stream Telemetry</h3>
                <p class="text-neutral-400 text-sm">Aggregating market exchange signals, game analytics, and cloud node performance into a single stream.</p>
            </div>
            <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6">
                <div class="text-xs font-mono uppercase tracking-wider text-sky-400 mb-2">03 // ECOSYSTEM LINK</div>
                <h3 class="text-xl font-bold mb-3">Monolith Bridge</h3>
                <p class="text-neutral-400 text-sm">Instant SSO and session relay across MonolithGames.com (65002) and Monolith Store (65004).</p>
            </div>
        </div>

        <div class="bg-gradient-to-r from-sky-950 to-neutral-900 border border-sky-800/50 rounded-2xl p-8 flex justify-between items-center">
            <div>
                <h2 class="text-2xl font-bold mb-2">Access Monolith Store Catalog</h2>
                <p class="text-neutral-300 text-sm">Browse all 1,000+ Android games and HD packages at port 65004.</p>
            </div>
            <a href="http://localhost:65004" target="_blank" class="bg-sky-500 hover:bg-sky-400 text-black font-bold px-6 py-3 rounded-xl transition">
                Open Monolith Store (Port 65004) ->
            </a>
        </div>
    </main>
</div>
