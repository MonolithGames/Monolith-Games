@page "/auora"

<PageTitle>Auora.com / Autonomous Intelligence & Cloud Infrastructure</PageTitle>

<div class="min-h-screen bg-[#030712] text-white p-8">
    <header class="flex justify-between items-center mb-16 max-w-7xl mx-auto border-b border-neutral-800 pb-6">
        <div class="text-2xl font-bold tracking-wider font-mono text-emerald-400">AUORA<span class="text-white">.COM</span></div>
        <div class="flex space-x-6 text-sm font-mono text-neutral-400">
            <span class="text-emerald-400">● SYSTEM STATUS: ONLINE (PORT 65005)</span>
            <span>ENTERPRISE CLOUD</span>
            <span>AI QUANTUM</span>
        </div>
    </header>

    <main class="max-w-7xl mx-auto">
        <div class="mb-16">
            <h1 class="text-5xl font-extrabold tracking-tight mb-4">Autonomous Intelligence for Global Infrastructure.</h1>
            <p class="text-xl text-neutral-400 max-w-2xl">Auora powers next-generation quantum computing, decentralized financial ledgers, and hyper-scalable cloud orchestration.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
            <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6">
                <div class="text-xs font-mono uppercase tracking-wider text-emerald-400 mb-2">01 // QUANTUM AI</div>
                <h3 class="text-xl font-bold mb-3">Self-Coding Neural Clusters</h3>
                <p class="text-neutral-400 text-sm">Autonomous agent synthesis executing high-frequency mathematical proofs and real-time market risk assessment.</p>
            </div>
            <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6">
                <div class="text-xs font-mono uppercase tracking-wider text-emerald-400 mb-2">02 // CLOUD MESH</div>
                <h3 class="text-xl font-bold mb-3">Zero-Latency Edge Routing</h3>
                <p class="text-neutral-400 text-sm">Distributed serverless infrastructure maintaining 99.999% uptime across global edge nodes.</p>
            </div>
            <div class="bg-neutral-900 border border-neutral-800 rounded-xl p-6">
                <div class="text-xs font-mono uppercase tracking-wider text-emerald-400 mb-2">03 // SECURITY VAULT</div>
                <h3 class="text-xl font-bold mb-3">Zero-Trust Cryptography</h3>
                <p class="text-neutral-400 text-sm">HMAC-SHA256 zero-trust token signing and hardware-secured transactional ledgers.</p>
            </div>
        </div>

        <div class="bg-gradient-to-r from-emerald-950 to-neutral-900 border border-emerald-800/50 rounded-2xl p-8 flex justify-between items-center">
            <div>
                <h2 class="text-2xl font-bold mb-2">Ready to deploy Auora Enterprise?</h2>
                <p class="text-neutral-300 text-sm">Connect your infrastructure to the Monolith-Auora ecosystem today.</p>
            </div>
            <a href="http://localhost:65000" class="bg-emerald-500 hover:bg-emerald-400 text-black font-bold px-6 py-3 rounded-xl transition">
                Access Monolith Console ->
            </a>
        </div>
    </main>
</div>
