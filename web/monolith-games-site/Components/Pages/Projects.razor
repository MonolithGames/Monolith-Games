@page "/projects"
@attribute [Authorize]
@using Monolith.Models
@using Monolith.Services
@inject TemplateCatalog Catalog
@inject WorkspaceStore Workspace

<PageTitle>Projects / Monolith</PageTitle>

<section class="dashboard-heading compact-heading">
    <div><p class="eyebrow">WORKSPACE / PROJECTS</p><h1>Build something real.</h1><p class="lede">Projects give your production jobs a home, a description, and a durable history.</p></div>
</section>

<section class="project-layout">
    <article class="operation-panel">
        <p class="eyebrow">NEW PROJECT</p>
        <h2>Start a workspace</h2>
        <EditForm Model="Draft" OnValidSubmit="CreateProject" class="project-form">
            <label>Name<input @bind="Draft.Name" required /></label>
            <label>Template<select @bind="Draft.TemplateSlug"><option value="">Choose a template</option>@foreach (var template in Templates) { <option value="@template.Slug">@template.Name</option> }</select></label>
            <label>Description<textarea @bind="Draft.Description" rows="4" placeholder="What are you making?"></textarea></label>
            <button type="submit">Create project <span aria-hidden="true">-></span></button>
        </EditForm>
        @if (!string.IsNullOrEmpty(Message)) { <p class="muted-copy">@Message</p> }
    </article>
    <article class="operation-panel project-list">
        <p class="eyebrow">PROJECT INDEX</p>
        <h2>Your projects</h2>
        @if (ProjectItems.Count == 0) { <p class="muted-copy">No projects created yet.</p> }
        @foreach (var project in ProjectItems)
        {
            <a class="project-row project-row-link" href="/projects/@project.Id"><div><strong>@project.Name</strong><small>@project.TemplateSlug · @project.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</small></div><span>@project.Description</span></a>
        }
    </article>
</section>

@code {
    private IReadOnlyList<GameTemplate> Templates = [];
    private IReadOnlyList<Project> ProjectItems = [];
    private ProjectDraft Draft = new();
    private string? Message;

    protected override void OnInitialized()
    {
        Templates = Catalog.GetAll();
        Refresh();
    }

    private void CreateProject()
    {
        if (Workspace.CreateProject(Draft.Name, Draft.TemplateSlug, Draft.Description) is null)
        {
            Message = "Choose a name and template before creating the project.";
            return;
        }
        Draft = new();
        Message = "Project created.";
        Refresh();
    }

    private void Refresh() => ProjectItems = Workspace.GetProjects();

    private sealed class ProjectDraft
    {
        public string Name { get; set; } = string.Empty;
        public string TemplateSlug { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}
