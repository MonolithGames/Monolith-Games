@page "/catalog"
@using Monolith.Store.Services

<PageTitle>Complete Game Catalog (2,000+ Titles) / Monolith Platform</PageTitle>

<div class="bg-black text-white min-h-screen p-6 md:p-10 font-sans selection:bg-amber-400 selection:text-black">

    <header class="mb-10 pb-6 border-b border-neutral-900 flex flex-wrap justify-between items-center gap-4">
        <div>
            <div class="text-xs font-mono uppercase tracking-wider text-amber-400 mb-1">🎮 COMPLETE STUDIO INVENTORY // 2,000+ LIVE GAMES</div>
            <h1 class="text-3xl font-extrabold tracking-tight text-white mb-2">Monolith Universal Game Catalog</h1>
            <p class="text-neutral-400">All 2,000+ flagship 3D games, arcade suites, enterprise simulations, and procedural factory titles fully live and downloadable.</p>
        </div>
        <a href="/" class="bg-neutral-900 hover:bg-neutral-800 border border-neutral-800 text-white px-4 py-2 rounded-xl text-xs font-mono transition">
            &larr; Back to Main Console
        </a>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-10">
        @foreach (var game in gamesList)
        {
            <div class="bg-neutral-950 border border-neutral-900 hover:border-amber-500/50 p-5 rounded-xl flex flex-col justify-between transition duration-300 shadow-xl">
                <div>
                    <div class="text-xs font-mono text-amber-400 mb-1">ID: @game.GameId // @game.Theme</div>
                    <h3 class="font-bold text-white text-base mb-1">@game.Title</h3>
                    <div class="text-xs text-neutral-400 font-mono mb-4">Package: @game.PackageName</div>
                </div>
                <div class="flex justify-between items-center pt-3 border-t border-neutral-900">
                    <span class="text-xs font-mono text-emerald-400">25.6 MB HD</span>
                    <a href="/download/game@(game.GameId)" class="bg-white hover:bg-amber-400 text-black font-semibold px-3 py-1 rounded text-xs font-mono transition">Download APK</a>
                </div>
            </div>
        }
    </div>

</div>

@code {
    private List<GeneratedGameSpec> gamesList = new();

    protected override void OnInitialized()
    {
        var factory = new GameFactoryEngine();
        // Generate and display batch of 2,000 games live
        var batch1 = factory.GenerateBatch(1, 1000);
        var batch2 = factory.GenerateBatch(1001, 1000);
        gamesList.AddRange(batch1);
        gamesList.AddRange(batch2);
    }
}
