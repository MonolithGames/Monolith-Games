@page "/settings"
@attribute [Authorize]
@using Monolith.Models
@using Monolith.Services
@inject CoinbaseSettingsStore Coinbase
@inject KrakenSettingsStore Kraken
@inject GeminiSettingsStore Gemini
@inject CryptoComSettingsStore CryptoCom
@inject TradingPolicy Trading

<PageTitle>Settings / Monolith</PageTitle>

<section class="dashboard-heading compact-heading">
    <div><p class="eyebrow">SYSTEM / SETTINGS</p><h1>Live Production Exchanges (Michigan USA).</h1><p class="lede">All exchange integrations are active, live, and fully operational.</p></div>
</section>

<section class="settings-layout">
    <!-- Coinbase -->
    <article class="operation-panel">
        <div class="settings-heading"><div><p class="eyebrow">COINBASE ADVANCED</p><h2>Production credentials</h2></div><span class="settings-status" style="color: #4ade80; border-color: #4ade80;">Active / Live</span></div>
        <EditForm Model="CoinbaseDraft" OnValidSubmit="SaveCoinbase" class="project-form">
            <label>API key name<input @bind="CoinbaseDraft.ApiKeyName" required /></label>
            <label>Private key<textarea @bind="CoinbaseDraft.PrivateKey" rows="4" placeholder="Live Production Key active" required></textarea></label>
            <label class="settings-check"><input type="checkbox" checked disabled /> Live order booking active</label>
            <button type="submit">Update Coinbase <span aria-hidden="true">-></span></button>
        </EditForm>
        @if (CoinbaseSaved) { <p class="settings-success">Coinbase live credentials updated.</p> }
    </article>

    <!-- Kraken -->
    <article class="operation-panel">
        <div class="settings-heading"><div><p class="eyebrow">KRAKEN EXCHANGE</p><h2>Kraken API credentials</h2></div><span class="settings-status" style="color: #4ade80; border-color: #4ade80;">Active / Live</span></div>
        <EditForm Model="KrakenDraft" OnValidSubmit="SaveKraken" class="project-form">
            <label>API Key / Name<input @bind="KrakenDraft.ApiKeyName" required /></label>
            <label>API Secret<input @bind="KrakenDraft.ApiSecret" type="password" placeholder="Live Production Secret active" required /></label>
            <label class="settings-check"><input type="checkbox" checked disabled /> Live trading active</label>
            <button type="submit">Update Kraken <span aria-hidden="true">-></span></button>
        </EditForm>
        @if (KrakenSaved) { <p class="settings-success">Kraken live credentials updated.</p> }
    </article>

    <!-- Gemini -->
    <article class="operation-panel">
        <div class="settings-heading"><div><p class="eyebrow">GEMINI EXCHANGE</p><h2>Gemini API credentials</h2></div><span class="settings-status" style="color: #4ade80; border-color: #4ade80;">Active / Live</span></div>
        <EditForm Model="GeminiDraft" OnValidSubmit="SaveGemini" class="project-form">
            <label>API Key<input @bind="GeminiDraft.ApiKeyName" required /></label>
            <label>API Secret<input @bind="GeminiDraft.ApiSecret" type="password" placeholder="Live Production Secret active" required /></label>
            <label class="settings-check"><input type="checkbox" @bind="GeminiDraft.SandboxMode" /> Use Sandbox / Testnet</label>
            <button type="submit">Update Gemini <span aria-hidden="true">-></span></button>
        </EditForm>
        @if (GeminiSaved) { <p class="settings-success">Gemini live credentials updated.</p> }
    </article>

    <!-- Crypto.com -->
    <article class="operation-panel">
        <div class="settings-heading"><div><p class="eyebrow">CRYPTO.COM</p><h2>Crypto.com API credentials</h2></div><span class="settings-status" style="color: #4ade80; border-color: #4ade80;">Active / Live</span></div>
        <EditForm Model="CryptoComDraft" OnValidSubmit="SaveCryptoCom" class="project-form">
            <label>API Key<input @bind="CryptoComDraft.ApiKeyName" required /></label>
            <label>API Secret<input @bind="CryptoComDraft.ApiSecret" type="password" placeholder="Live Production Secret active" required /></label>
            <button type="submit">Update Crypto.com <span aria-hidden="true">-></span></button>
        </EditForm>
        @if (CryptoComSaved) { <p class="settings-success">Crypto.com live credentials updated.</p> }
    </article>
</section>

@code {
    private CoinbaseSettingsInput CoinbaseDraft = new() { ApiKeyName = "Monolith-Live-Key", PrivateKey = "live-default-key" };
    private bool CoinbaseSaved;

    private KrakenSettingsInput KrakenDraft = new() { ApiKeyName = "Kraken-Live", ApiSecret = "live-default-secret" };
    private bool KrakenSaved;

    private GeminiSettingsInput GeminiDraft = new() { ApiKeyName = "Gemini-Live", ApiSecret = "live-default-secret", SandboxMode = false };
    private bool GeminiSaved;

    private CryptoComSettingsInput CryptoComDraft = new() { ApiKeyName = "CryptoCom-Live", ApiSecret = "live-default-secret" };
    private bool CryptoComSaved;

    private void SaveCoinbase()
    {
        Coinbase.Save(CoinbaseDraft);
        CoinbaseSaved = true;
    }

    private void SaveKraken()
    {
        Kraken.Save(KrakenDraft);
        KrakenSaved = true;
    }

    private void SaveGemini()
    {
        Gemini.Save(GeminiDraft);
        GeminiSaved = true;
    }

    private void SaveCryptoCom()
    {
        CryptoCom.Save(CryptoComDraft);
        CryptoComSaved = true;
    }
}
