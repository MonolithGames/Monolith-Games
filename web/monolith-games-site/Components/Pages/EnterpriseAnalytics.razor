@page "/enterprise-analytics"
@using Monolith.Models

<PageTitle>Enterprise Analytics / Monolith Platform</PageTitle>

<div class="p-6">
    <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-white mb-2">Global Enterprise Telemetry & Analytics</h1>
        <p class="text-neutral-400">Real-time aggregate performance metrics across Monolith Arcade, Enterprise Simulation, and Incorporated Corporate Games.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="bg-neutral-900 border border-neutral-800 rounded-lg p-5">
            <div class="text-xs font-mono uppercase tracking-wider text-neutral-400 mb-2">Total Published Games</div>
            <div class="text-3xl font-bold text-white">1,032 Active Titles</div>
            <div class="text-xs text-emerald-400 mt-2">● 1,000 Procedural + 32 Curated</div>
        </div>
        <div class="bg-neutral-900 border border-neutral-800 rounded-lg p-5">
            <div class="text-xs font-mono uppercase tracking-wider text-neutral-400 mb-2">Monthly Active Users</div>
            <div class="text-3xl font-bold text-emerald-400">4.85 Million</div>
            <div class="text-xs text-emerald-400 mt-2">▲ +12.4% vs last month</div>
        </div>
        <div class="bg-neutral-900 border border-neutral-800 rounded-lg p-5">
            <div class="text-xs font-mono uppercase tracking-wider text-neutral-400 mb-2">AdMob & IAP ARR</div>
            <div class="text-3xl font-bold text-sky-400">$18.4M USD</div>
            <div class="text-xs text-sky-400 mt-2">● Monolith Billing Engine Active</div>
        </div>
        <div class="bg-neutral-900 border border-neutral-800 rounded-lg p-5">
            <div class="text-xs font-mono uppercase tracking-wider text-neutral-400 mb-2">Crash-Free Rate</div>
            <div class="text-3xl font-bold text-indigo-400">99.98%</div>
            <div class="text-xs text-indigo-400 mt-2">● Sentinel Health Verified</div>
        </div>
    </div>

    <div class="bg-neutral-900 border border-neutral-800 rounded-lg p-6">
        <h2 class="text-xl font-semibold text-white mb-4">Active Suite Distribution & Telemetry</h2>
        <div class="space-y-4">
            <div class="flex justify-between items-center border-b border-neutral-800 pb-3">
                <div>
                    <div class="font-medium text-white">Monolith Incorporated Suite</div>
                    <div class="text-xs text-neutral-400">CorpStudioNexus, CorpApexSim, CorpNeuralNetAI, etc.</div>
                </div>
                <div class="text-right">
                    <div class="font-mono text-emerald-400 text-sm font-semibold">$8.2M ARR</div>
                    <div class="text-xs text-neutral-500">1.2M Active Users</div>
                </div>
            </div>
            <div class="flex justify-between items-center border-b border-neutral-800 pb-3">
                <div>
                    <div class="font-medium text-white">Monolith Enterprise Simulation Suite</div>
                    <div class="text-xs text-neutral-400">EnterpriseFlightSim, EnterpriseMarketTrader, EnterpriseGridManager</div>
                </div>
                <div class="text-right">
                    <div class="font-mono text-sky-400 text-sm font-semibold">$6.4M ARR</div>
                    <div class="text-xs text-neutral-500">850K Active Users</div>
                </div>
            </div>
            <div class="flex justify-between items-center">
                <div>
                    <div class="font-medium text-white">Monolith 1,000 Arcade Games Catalog</div>
                    <div class="text-xs text-neutral-400">VoidStrikers, ArcadeAether through ArcadeZenith, 1,000 Procedural Games</div>
                </div>
                <div class="text-right">
                    <div class="font-mono text-indigo-400 text-sm font-semibold">$3.8M ARR</div>
                    <div class="text-xs text-neutral-500">2.8M Active Users</div>
                </div>
            </div>
        </div>
    </div>
</div>
