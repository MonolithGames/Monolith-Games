@page "/"
@attribute [Authorize]
@using Monolith.Web.Models
@using Monolith.Web.Services
@inject TemplateCatalog Catalog
@inject WorkspaceStore Workspace

<PageTitle>Monolith / Production desk</PageTitle>

<section class="dashboard-heading">
	<div>
		<p class="eyebrow">MONOLITH / PRODUCTION DESK</p>
		<h1>Choose what ships next.</h1>
		<p class="lede">A focused workspace for shaping game concepts into build-ready production jobs.</p>
	</div>
	<div class="health-pill"><span></span> Pipeline idle</div>
</section>

<section class="summary-grid" aria-label="Production summary">
	<div class="summary-card"><span class="summary-label">Templates</span><strong>@Templates.Count</strong><small>Available to start</small></div>
	<div class="summary-card"><span class="summary-label">Active jobs</span><strong>@Jobs.Count(job => job.Status is "Queued" or "Running pipeline")</strong><small>Local jobs in progress</small></div>
	<div class="summary-card"><span class="summary-label">Release lane</span><strong>Review</strong><small>Human approval required</small></div>
</section>

@if (Jobs.Count > 0)
{
	<section class="jobs-strip">
		<div class="section-heading"><div><p class="eyebrow">RECENT JOBS</p><h2>Production queue</h2></div><a class="api-link" href="/jobs">Open history <span aria-hidden="true">-></span></a></div>
		@foreach (var job in Jobs.Take(3))
		{
			<div class="job-row"><div><strong>@job.TemplateName</strong><small>@job.CreatedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</small></div><span class="job-status">@job.Status</span><div class="job-progress"><i style="width: @job.Progress%"></i></div></div>
		}
	</section>
}

<section class="template-section">
	<div class="section-heading">
		<div>
			<p class="eyebrow">TEMPLATE CATALOG</p>
			<h2>Production starters</h2>
		</div>
		<a class="api-link" href="/api/templates" target="_blank">View API data <span aria-hidden="true">-></span></a>
	</div>

	<div class="template-grid">
		@for (var index = 0; index < Templates.Count; index++)
		{
			var template = Templates[index];
			<article class="template-card" style="--accent: @template.Accent">
				<div class="template-card-top">
					<span class="template-index">0@(index + 1)</span>
					<span class="template-status">@template.Status</span>
				</div>
				<div class="template-mark">@template.Name.Substring(0, 1)</div>
				<p class="template-category">@template.Category</p>
				<h3>@template.Name</h3>
				<p class="template-description">@template.Description</p>
				<div class="pipeline-preview">
					@foreach (var stage in template.Pipeline)
					{
						<span>@stage</span>
					}
				</div>
				<button class="launch-button" @onclick="() => CreateJob(template)">
					@(SelectedTemplate?.Slug == template.Slug ? "Job created" : "Create production job")
					<span aria-hidden="true">-></span>
				</button>
			</article>
		}
	</div>
</section>

@if (SelectedTemplate is not null)
{
	<section class="selection-banner" aria-live="polite">
		<div><span class="eyebrow">SELECTED TEMPLATE</span><strong>@SelectedTemplate.Name</strong></div>
		<span>Ready to create a production job</span>
	</section>
}

@code {
	private IReadOnlyList<GameTemplate> Templates = [];
	private GameTemplate? SelectedTemplate;
	private IReadOnlyList<ProductionJob> Jobs = [];

	protected override void OnInitialized()
	{
		Templates = Catalog.GetAll();
		Jobs = Workspace.GetJobs();
	}

	private void SelectTemplate(GameTemplate template)
	{
		SelectedTemplate = template;
	}

	private void CreateJob(GameTemplate template)
	{
		SelectedTemplate = template;
		Workspace.CreateJob(template.Slug);
		Jobs = Workspace.GetJobs();
	}
}
