@page "/settings"
@attribute [Authorize]
@using Monolith.Models
@using Monolith.Services
@inject CoinbaseSettingsStore Coinbase
@inject TradingPolicy Trading

<PageTitle>Settings / Monolith</PageTitle>

<section class="dashboard-heading compact-heading">
    <div><p class="eyebrow">SYSTEM / SETTINGS</p><h1>Connect the market layer.</h1><p class="lede">Store Coinbase credentials securely for market data and explicitly opt in to gated live orders.</p></div>
</section>

<section class="settings-layout">
    <article class="operation-panel">
        <div class="settings-heading"><div><p class="eyebrow">COINBASE ADVANCED TRADE</p><h2>Production credentials</h2></div><span class="settings-status">@(Status.IsConfigured ? "Configured" : "Not configured")</span></div>
        <p class="muted-copy">The private key is encrypted before it is saved. It is never displayed again or returned by the API.</p>
        <EditForm Model="Draft" OnValidSubmit="Save" class="project-form">
            <label>API key name<input @bind="Draft.ApiKeyName" autocomplete="off" required /></label>
            <label>Private key<textarea @bind="Draft.PrivateKey" rows="7" autocomplete="off" placeholder="Paste the Coinbase signing key here" required></textarea></label>
            <label class="settings-check"><input type="checkbox" @bind="Draft.LiveTradingEnabled" /> Enable gated live order booking</label>
            <label class="settings-check"><input type="checkbox" checked disabled /> Withdrawals disabled</label>
            <button type="submit">Save encrypted credentials <span aria-hidden="true">-></span></button>
        </EditForm>
        @if (Saved) { <p class="settings-success">Credentials encrypted and saved. The private key is not retrievable through Monolith.</p> }
    @if (!string.IsNullOrEmpty(Error)) { <p class="login-error">@Error</p> }
    </article>
    <article class="operation-panel settings-note"><p class="eyebrow">TRADING CONTROL PLANE</p><h2>Readiness gates</h2><p class="lede">Live orders stay blocked until every production control is explicitly configured.</p><div class="adapter-row"><span>Live order booking</span><strong class="unconfigured">@(Trading.GetStatus().LiveTradingEnabled ? "Enabled" : "Disabled")</strong></div><div class="adapter-row"><span>Risk controls</span><strong class="@(Trading.GetStatus().RiskControlsReady ? "configured" : "unconfigured")">@(Trading.GetStatus().RiskControlsReady ? "Ready" : "Blocked")</strong></div><div class="adapter-row"><span>Withdrawals</span><strong class="unconfigured">Disabled</strong></div>@foreach (var reason in Trading.GetStatus().BlockingReasons) { <p class="muted-copy">· @reason</p> }</article>
</section>

@code {
    private CoinbaseSettingsStatus Status = new(false, null, false, false);
    private CoinbaseSettingsInput Draft = new();
    private bool Saved;
    private string? Error;

    protected override void OnInitialized() => Status = Coinbase.GetStatus();

    private void Save()
    {
        try
        {
            Coinbase.Save(Draft);
            Status = Coinbase.GetStatus();
            Draft = new() { ApiKeyName = Status.ApiKeyName ?? Draft.ApiKeyName };
            Saved = true;
            Error = null;
        }
        catch (InvalidOperationException exception)
        {
            Saved = false;
            Error = exception.Message;
        }
    }
}
