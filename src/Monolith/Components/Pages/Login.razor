@page "/login"
@attribute [AllowAnonymous]
@using Monolith.Services
@inject AccountService Accounts

<PageTitle>Sign in / Monolith</PageTitle>

<section class="login-shell">
    <div class="login-panel">
        <p class="eyebrow">MONOLITH / ACCESS</p>
        <h1>Welcome back.</h1>
        <p class="lede">Sign in to manage production jobs and release work.</p>
        @if (!Accounts.IsConfigured)
        {
            <div class="login-warning">Set <code>AUORA_PASSWORD</code> before signing in.</div>
        }
        @if (Error)
        {
            <div class="login-error">Those credentials were not accepted.</div>
        }
        <form method="post" action="/api/auth/login" class="login-form">
            <label>Username<input name="userName" value="auora" autocomplete="username" required /></label>
            <label>Password<input name="password" type="password" autocomplete="current-password" required /></label>
            <button type="submit">Sign in <span aria-hidden="true">-></span></button>
        </form>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorValue { get; set; }

    private bool Error => ErrorValue == "1";
}