@page "/operations"
@attribute [Authorize]
@using Monolith.Services
@inject IConfiguration Configuration
@inject MediaLibrary Media

<PageTitle>Operations / Monolith</PageTitle>

<section class="dashboard-heading compact-heading">
    <div><p class="eyebrow">SYSTEM / OPERATIONS</p><h1>Keep the pipeline honest.</h1><p class="lede">Review worker adapters and bring production media into the workspace.</p></div>
</section>

<section class="operations-grid">
    <article class="operation-panel"><p class="eyebrow">WORKER ADAPTERS</p><h2>Connection status</h2>
        @foreach (var adapter in Adapters)
        {
            <div class="adapter-row"><span>@adapter.Name</span><strong class="@(adapter.Configured ? "configured" : "unconfigured")">@(adapter.Configured ? "Configured" : "Not configured")</strong></div>
        }
    </article>
    <article class="operation-panel"><p class="eyebrow">MEDIA LIBRARY</p><h2>Project files</h2>
        <form method="post" action="/api/media" enctype="multipart/form-data" class="media-upload"><input type="file" name="file" required /><button type="submit">Upload media</button></form>
        @if (Files.Count == 0) { <p class="muted-copy">No media uploaded yet.</p> }
        @foreach (var file in Files) { <div class="file-row"><span>@file</span><span>Stored locally</span></div> }
    </article>
</section>

@code {
    private List<(string Name, bool Configured)> Adapters = [];
    private IReadOnlyList<string> Files = [];

    protected override void OnInitialized()
    {
        Adapters = [("Azure worker", Has("MONOLITH_AZURE_COMMAND")), ("Maya assets", Has("MONOLITH_MAYA_COMMAND")), ("Unity build", Has("MONOLITH_UNITY_COMMAND")), ("Media package", Has("MONOLITH_MEDIA_COMMAND")), ("Publishing", Has("MONOLITH_PUBLISH_COMMAND"))];
        Files = Media.GetFiles();
    }

    private bool Has(string key) => !string.IsNullOrWhiteSpace(Configuration[key]);
}