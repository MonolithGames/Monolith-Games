@page "/jobs"
@attribute [Authorize]
@implements IAsyncDisposable
@using Monolith.Models
@using Monolith.Services
@inject WorkspaceStore Workspace

<PageTitle>Jobs / Monolith</PageTitle>

<section class="dashboard-heading compact-heading">
    <div><p class="eyebrow">WORKSPACE / JOB HISTORY</p><h1>Production jobs.</h1><p class="lede">Every project launch is tracked locally until the worker pipeline is connected.</p></div>
</section>

<section class="jobs-table" aria-label="Production jobs">
    <div class="jobs-table-head"><span>Template</span><span>Status</span><span>Progress</span><span>Updated</span><span></span></div>
    @if (JobItems.Count == 0)
    {
        <div class="empty-state">No jobs yet. Return to the production desk to create one.</div>
    }
    @foreach (var job in JobItems)
    {
        <div class="jobs-table-row"><strong>@job.TemplateName</strong><span class="job-status">@job.Status</span><div class="job-progress"><i style="width: @job.Progress%"></i></div><span>@job.UpdatedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</span><span class="job-actions"><button class="advance-button" @onclick="() => Advance(job.Id)">Advance</button><button class="advance-button" @onclick="() => Cancel(job.Id)">Cancel</button><button class="advance-button" @onclick="() => Retry(job.Id)">Retry</button></span></div>
    }
</section>

@code {
    private IReadOnlyList<ProductionJob> JobItems = [];
    private readonly CancellationTokenSource refreshCancellation = new();

    protected override void OnInitialized()
    {
        Refresh();
        _ = RefreshLoopAsync();
    }

    private void Advance(Guid id)
    {
        Workspace.AdvanceJob(id);
        Refresh();
    }

    private void Cancel(Guid id)
    {
        Workspace.CancelJob(id);
        Refresh();
    }

    private void Retry(Guid id)
    {
        Workspace.RetryJob(id);
        Refresh();
    }

    private void Refresh() => JobItems = Workspace.GetJobs();

    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(refreshCancellation.Token))
            {
                await InvokeAsync(() =>
                {
                    Refresh();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested)
        {
        }
    }

    public ValueTask DisposeAsync()
    {
        refreshCancellation.Cancel();
        refreshCancellation.Dispose();
        return ValueTask.CompletedTask;
    }
}