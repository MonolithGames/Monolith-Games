@page "/projects/{ProjectId:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@using Monolith.Models
@using Monolith.Services
@inject WorkspaceStore Workspace
@inject MediaLibrary Media

<PageTitle>@(Project?.Name ?? "Project") / Monolith</PageTitle>

@if (Project is null)
{
    <section class="auth-required"><h1>Project not found</h1><a href="/projects">Back to projects</a></section>
}
else
{
    <section class="dashboard-heading compact-heading project-detail-heading">
        <div><p class="eyebrow">PROJECT / @Project.TemplateSlug.ToUpperInvariant()</p><h1>@Project.Name</h1><p class="lede">@Project.Description</p></div>
        <a class="api-link" href="/projects">All projects <span aria-hidden="true">-></span></a>
    </section>

    <section class="project-metrics">
        <div class="summary-card"><span class="summary-label">Jobs</span><strong>@Jobs.Count</strong><small>Tracked production runs</small></div>
        <div class="summary-card"><span class="summary-label">Active</span><strong>@Jobs.Count(job => job.Status is "Queued" or "Running pipeline")</strong><small>Worker activity</small></div>
        <div class="summary-card"><span class="summary-label">Files</span><strong>@Files.Count</strong><small>Workspace media</small></div>
    </section>

    <section class="detail-grid">
        <article class="operation-panel"><p class="eyebrow">PIPELINE RUNS</p><h2>Job history</h2>
            @if (Jobs.Count == 0) { <p class="muted-copy">No jobs have been launched for this project.</p> }
            @foreach (var job in Jobs)
            {
                <div class="detail-job-row"><div><strong>@job.TemplateName</strong><small>@job.Status · @job.Progress%</small></div><div class="job-progress"><i style="width: @job.Progress%"></i></div><div class="job-actions"><button class="advance-button" @onclick="() => RunAction(() => Workspace.AdvanceJob(job.Id))">Advance</button><button class="advance-button" @onclick="() => RunAction(() => Workspace.ApproveJob(job.Id))">Approve</button><button class="advance-button" @onclick="() => RunAction(() => Workspace.CancelJob(job.Id))">Cancel</button><button class="advance-button" @onclick="() => RunAction(() => Workspace.RetryJob(job.Id))">Retry</button></div></div>
            }
        </article>
        <article class="operation-panel"><p class="eyebrow">WORKSPACE LOG</p><h2>Latest activity</h2>
            @if (Logs.Count == 0) { <p class="muted-copy">Job activity will appear here.</p> }
            @foreach (var log in Logs.TakeLast(12).Reverse()) { <div class="timeline-row"><span></span><div><strong>@log.Message</strong><small>@log.CreatedAtUtc.ToLocalTime().ToString("MMM d, h:mm:ss tt")</small></div></div> }
        </article>
    </section>

    <section class="operation-panel project-files-panel"><p class="eyebrow">ARTIFACTS / MEDIA</p><h2>Workspace files</h2>@if (Files.Count == 0) { <p class="muted-copy">No uploaded files yet. Add media from Operations.</p> } else { <div class="file-grid">@foreach (var file in Files) { <span>@file</span> }</div> }</section>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    private Project? Project;
    private IReadOnlyList<ProductionJob> Jobs = [];
    private IReadOnlyList<ProjectLog> Logs = [];
    private IReadOnlyList<string> Files = [];
    private readonly CancellationTokenSource refreshCancellation = new();

    protected override void OnInitialized()
    {
        Refresh();
        _ = RefreshLoopAsync();
    }

    private void Refresh()
    {
        Project = Workspace.GetProject(ProjectId);
        Jobs = Project is null ? [] : Workspace.GetProjectJobs(ProjectId);
        Logs = Jobs.SelectMany(job => Workspace.GetLogs(job.Id)).OrderBy(log => log.CreatedAtUtc).ToArray();
        Files = Media.GetFiles();
    }

    private void RunAction(Func<ProductionJob?> action)
    {
        action();
        Refresh();
    }

    private async Task RefreshLoopAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try { while (await timer.WaitForNextTickAsync(refreshCancellation.Token)) await InvokeAsync(() => { Refresh(); StateHasChanged(); }); }
        catch (OperationCanceledException) when (refreshCancellation.IsCancellationRequested) { }
    }

    public ValueTask DisposeAsync() { refreshCancellation.Cancel(); refreshCancellation.Dispose(); return ValueTask.CompletedTask; }
}